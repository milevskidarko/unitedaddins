# Copy to .env.local to send test quote requests to your own inbox instead of sales@ (FormSubmit fallback).
# .env.local is git-ignored and is NOT used on Vercel (production keeps sales@unitedaddins.com).
VITE_FORM_EMAIL=your-email@example.com

# --- New quote backend (api/quote.js). Set these on Vercel → Settings → Environment Variables ---
# Resend (resend.com): API key; the unitedaddins.com domain must be verified there.
RESEND_API_KEY=
# Optional sender / recipient overrides
QUOTE_FROM=United Addins Website <quotes@unitedaddins.com>
QUOTE_TO=sales@unitedaddins.com
# Cloudflare Turnstile (dash.cloudflare.com → Turnstile): site key is public, secret key is server-only.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
